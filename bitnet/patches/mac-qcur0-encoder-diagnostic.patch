+bool ggml_metal_encoder_qcur0_probe_end(ggml_metal_encoder_t encoder) {
+    if (!encoder->q_probe_active || !encoder->q_probe_record) { return false; }
+    NSMutableDictionary * record=encoder->q_probe_record;
+    const bool empty=[record[@"mode"] isEqualToString:@"empty"];
+    const bool tuple=empty ? [record[@"scope_dispatches"] unsignedLongLongValue]==0 :
+        [record[@"scope_dispatches"] unsignedLongLongValue]==1 &&
+        [record[@"planned_native_PSO"] isEqual:record[@"actual_native_PSO"]] &&
+        [record[@"planned_args_hex"] isEqual:record[@"actual_args_hex"]] &&
+        [record[@"planned_buffers"] isEqual:record[@"actual_buffers"]] &&
+        [record[@"planned_grid"] isEqual:record[@"actual_grid"]] &&
+        [record[@"planned_threads"] isEqual:record[@"actual_threads"]] &&
+        [record[@"planned_smem"] isEqual:record[@"actual_smem"]];
+    [encoder->obj updateFence:encoder->q_probe_fence]; [encoder->obj endEncoding]; [encoder->obj release];
