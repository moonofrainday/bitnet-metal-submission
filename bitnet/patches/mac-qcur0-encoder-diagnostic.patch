+static NSString * bitnet_q_probe_hex(const void * data, size_t size) {
+    NSMutableString * result=[NSMutableString stringWithCapacity:2*size];
+    const unsigned char * bytes=data;
+    for (size_t i=0;i<size;++i) { [result appendFormat:@"%02x",bytes[i]]; }
+    return result;
+}
+
+static NSDictionary * bitnet_q_probe_buffer(struct ggml_metal_buffer_id binding) {
+    id<MTLBuffer> buffer=(id<MTLBuffer>)binding.metal;
+    return @{@"buffer":@((uintptr_t)buffer), @"offset":@(binding.offs),
+        @"buffer_length":@(buffer.length), @"hazard_tracking_mode":@(buffer.hazardTrackingMode)};
+}
+
+static NSDictionary * bitnet_q_probe_tensor(const struct ggml_tensor * tensor, struct ggml_metal_buffer_id binding) {
+    NSMutableArray * ne=[NSMutableArray arrayWithCapacity:4], * nb=[NSMutableArray arrayWithCapacity:4];
+    for (int i=0;i<4;++i) { [ne addObject:@(tensor->ne[i])]; [nb addObject:@(tensor->nb[i])]; }
+    return @{@"name":@(tensor->name), @"type":@(ggml_type_name(tensor->type)), @"ne":ne, @"nb":nb,
+        @"bytes":@(ggml_nbytes(tensor)), @"binding":bitnet_q_probe_buffer(binding)};
+}
