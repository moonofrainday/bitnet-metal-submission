+static bool bitnet_q_probe_reset_locked(void) {
+    [bitnet_q_probe_samples release]; bitnet_q_probe_samples=nil;
+    [bitnet_q_probe_device release]; bitnet_q_probe_device=nil;
+    [bitnet_q_probe_fences release]; bitnet_q_probe_fences=nil;
+    [bitnet_q_probe_records release]; bitnet_q_probe_records=nil;
+    bitnet_q_probe_ready=false; bitnet_q_probe_drops=0;
+    bitnet_q_probe_cpu_before=0; bitnet_q_probe_gpu_before=0;
+    bitnet_q_probe_error="none";
+    const char * value=getenv("GGML_METAL_QCUR0_ENCODER_PROBE");
+    bitnet_q_probe_mode=!value || !value[0] || strcmp(value,"0")==0 ? "off" :
+        strcmp(value,"1")==0 ? "target" : strcmp(value,"empty")==0 ? "empty" : "invalid";
+    if (strcmp(bitnet_q_probe_mode,"off")==0) { return true; }
+    if (strcmp(bitnet_q_probe_mode,"invalid")==0) { bitnet_q_probe_error="invalid_selector"; return false; }
+#if !TARGET_OS_OSX
+    bitnet_q_probe_error="Mac_only_probe"; return false;
+#else
+    bitnet_q_probe_device=MTLCreateSystemDefaultDevice();
+    if (!bitnet_q_probe_device || ![bitnet_q_probe_device supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary]) {
+        bitnet_q_probe_error="stage_boundary_sampling_unavailable"; return false;
+    }
+    id<MTLCounterSet> timestamp_set=nil;
+    for (id<MTLCounterSet> set in bitnet_q_probe_device.counterSets) {
+        if ([set.name isEqualToString:MTLCommonCounterSetTimestamp]) { timestamp_set=set; break; }
+    }
+    if (!timestamp_set) { bitnet_q_probe_error="timestamp_counter_set_unavailable"; return false; }
+    MTLCounterSampleBufferDescriptor * descriptor=[[MTLCounterSampleBufferDescriptor alloc] init];
+    descriptor.counterSet=timestamp_set; descriptor.storageMode=MTLStorageModeShared;
+    descriptor.sampleCount=2*BITNET_Q_ENCODER_PROBE_CAPACITY;
+    descriptor.label=@"Qcur-0 diagnostic preallocated timestamp pool";
+    NSError * error=nil;
+    bitnet_q_probe_samples=[bitnet_q_probe_device newCounterSampleBufferWithDescriptor:descriptor error:&error];
+    [descriptor release];
+    if (!bitnet_q_probe_samples) { bitnet_q_probe_error="timestamp_pool_allocation_failed"; return false; }
+    bitnet_q_probe_fences=[[NSMutableArray alloc] initWithCapacity:BITNET_Q_ENCODER_PROBE_CAPACITY];
+    bitnet_q_probe_records=[[NSMutableArray alloc] initWithCapacity:BITNET_Q_ENCODER_PROBE_CAPACITY];
+    for (size_t i=0;i<BITNET_Q_ENCODER_PROBE_CAPACITY;++i) {
+        id<MTLFence> fence=[bitnet_q_probe_device newFence];
+        if (!fence) { bitnet_q_probe_error="fence_pool_allocation_failed"; return false; }
+        [bitnet_q_probe_fences addObject:fence]; [fence release];
+    }
+    [bitnet_q_probe_device sampleTimestamps:&bitnet_q_probe_cpu_before gpuTimestamp:&bitnet_q_probe_gpu_before];
+    bitnet_q_probe_ready=bitnet_q_probe_cpu_before>0 && bitnet_q_probe_gpu_before>0;
+    if (!bitnet_q_probe_ready) { bitnet_q_probe_error="invalid_clock_bracket_before"; }
+    return bitnet_q_probe_ready;
+#endif
+}
