+static bool bitnet_q_probe_write_locked(FILE * file) {
+    const bool enabled=strcmp(bitnet_q_probe_mode,"off")!=0;
+    uint64_t cpu_after=0,gpu_after=0;
+    NSData * resolved=nil;
+    if (enabled && bitnet_q_probe_ready) {
+        [bitnet_q_probe_device sampleTimestamps:&cpu_after gpuTimestamp:&gpu_after];
+        if (bitnet_q_probe_records.count>0) {
+            resolved=[bitnet_q_probe_samples resolveCounterRange:NSMakeRange(0,2*bitnet_q_probe_records.count)];
+        }
+    }
+    bool complete=!enabled || (bitnet_q_probe_ready && bitnet_q_probe_drops==0 &&
+        cpu_after>bitnet_q_probe_cpu_before && gpu_after>bitnet_q_probe_gpu_before &&
+        (bitnet_q_probe_records.count==0 || resolved.length==2*bitnet_q_probe_records.count*sizeof(MTLCounterResultTimestamp)));
+    const MTLCounterResultTimestamp * values=resolved.bytes;
+    const bool pool_complete=complete;
+    for (NSMutableDictionary * record in bitnet_q_probe_records) {
+        const size_t index=[record[@"sample_start_index"] unsignedLongLongValue];
+        const bool full_pair=values && resolved.length>=(index+2)*sizeof(*values);
+        const uint64_t start=full_pair ? values[index].timestamp : 0;
+        const uint64_t end=full_pair ? values[index+1].timestamp : 0;
+        bool command_complete=false;
+        int command_matches=0;
+        for (size_t i=0;i<bitnet_q_command_count;++i) {
+            const struct bitnet_q_attr_command * r=&bitnet_q_commands[i];
+            const int index=[record[@"graph_index"] intValue];
+            const uint64_t host=[record[@"scope_host_ns"] unsignedLongLongValue];
+            if (r->command==[record[@"command"] unsignedLongLongValue] && r->graph==[record[@"graph"] unsignedLongLongValue] &&
+                    r->step==[record[@"step"] intValue] && index>=r->slice_start && index<r->slice_end &&
+                    host>=r->encode_start_ns && host<=r->encode_end_ns) {
+                ++command_matches; command_complete=r->completed && r->status==MTLCommandBufferStatusCompleted;
+            }
+        }
+        const bool valid=pool_complete && [record[@"tuple_verified"] boolValue] && [record[@"encoder_scope_ended"] boolValue] &&
+            command_matches==1 && command_complete && start>0 && start!=MTLCounterErrorValue && end!=MTLCounterErrorValue &&
+            start>=bitnet_q_probe_gpu_before && end>=start && end<=gpu_after;
+        record[@"raw_gpu_start"]=@(start); record[@"raw_gpu_end"]=@(end);
+        record[@"GPU_command_completed"]=@(command_complete); record[@"valid"]=@(valid);
+        record[@"natural_CB_matches"]=@(command_matches);
+        record[@"elapsed_us"]=valid ? @((double)(end-start)/(double)(gpu_after-bitnet_q_probe_gpu_before)*(double)(cpu_after-bitnet_q_probe_cpu_before)/1e3) : (id)[NSNull null];
+        if (!valid) { complete=false; }
+    }
+    const char * custom=getenv("GGML_METAL_BITNET_POC"), * guard=getenv("GGML_METAL_BITNET_Q_GUARD_ONLY");
+    const bool stock_route=(!custom || strcmp(custom,"1")!=0) && (!guard || strcmp(guard,"1")!=0);
+    if (enabled && stock_route && bitnet_q_probe_records.count==0) { complete=false; }
+    NSDictionary * result=@{
+        @"enabled":@(enabled), @"mode":@(bitnet_q_probe_mode), @"scope":@"perturbative selected-stock-Q0 encoder interval, not normal-schedule critical-path share",
+        @"selected_route":@"S only; legitimate QB/Q4 routes stay unsplit", @"capacity":@(BITNET_Q_ENCODER_PROBE_CAPACITY),
+        @"records_count":@(bitnet_q_probe_records.count), @"dropped_records":@(bitnet_q_probe_drops), @"ready":@(bitnet_q_probe_ready), @"error":@(bitnet_q_probe_error),
+        @"counter_buffer_allocations_in_target_encode":@0, @"fence_allocations_in_target_encode":@0,
+        @"host_metadata_and_encoder_objects_created_in_encode":@YES,
+        @"extra_command_buffers":@0, @"extra_commits":@0, @"extra_CPU_waits":@0,
+        @"fence_policy":@"prefix update; selected encoder wait+update; suffix wait; used for both tracked and untracked buffers",
+        @"cpu_bracket_unit":@"nanoseconds from MTLDevice sampleTimestamps", @"gpu_bracket_unit":@"raw GPU clock",
+        @"cpu_before":@(bitnet_q_probe_cpu_before), @"gpu_before":@(bitnet_q_probe_gpu_before), @"cpu_after":@(cpu_after), @"gpu_after":@(gpu_after),
+        @"conversion":@"elapsed_us = raw_GPU_delta / GPU_bracket_delta * CPU_bracket_delta_ns / 1000",
+        @"clock_samples_taken_outside_decode_wall":@YES, @"records":bitnet_q_probe_records ?: @[], @"complete":@(complete)
+    };
+    NSError * error=nil;
+    NSData * data=[NSJSONSerialization dataWithJSONObject:result options:0 error:&error];
+    if (!data) { return false; }
+    fputs(",\"selected_q_encoder_probe\":",file); fwrite(data.bytes,1,data.length,file);
+    return complete;
+}
