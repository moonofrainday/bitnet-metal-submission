+bool ggml_metal_encoder_qcur0_probe_begin(ggml_metal_encoder_t encoder,
+        const struct ggml_tensor * node, const void * graph, int graph_index,
+        struct ggml_metal_pipeline_with_params pipeline, const void * args, size_t args_size,
+        struct ggml_metal_buffer_id weight, struct ggml_metal_buffer_id input,
+        struct ggml_metal_buffer_id output, int grid_x, int grid_y, int grid_z,
+        int threads_x, int threads_y, size_t smem) {
+    if (encoder->q_probe_active || encoder->abc_trace || !pipeline.pipeline || args_size>1024 ||
+        !ggml_metal_buffer_contains(weight,ggml_nbytes(node->src[0])) ||
+        !ggml_metal_buffer_contains(input,ggml_nbytes(node->src[1])) ||
+        !ggml_metal_buffer_contains(output,ggml_nbytes(node))) { return false; }
+    pthread_mutex_lock(&bitnet_q_command_lock);
+    if (!bitnet_q_probe_ready || encoder->obj.device.registryID!=bitnet_q_probe_device.registryID ||
+        bitnet_q_probe_records.count>=BITNET_Q_ENCODER_PROBE_CAPACITY) {
+        ++bitnet_q_probe_drops; pthread_mutex_unlock(&bitnet_q_command_lock); return false;
+    }
+    const size_t index=bitnet_q_probe_records.count;
+    id<MTLFence> fence=bitnet_q_probe_fences[index];
+    const char * step=getenv("GGML_METAL_BITNET_FFN_STEP");
+    NSMutableDictionary * record=[@{
+        @"step":@(step?atoi(step):-1), @"graph":@((uintptr_t)graph), @"graph_index":@(graph_index),
+        @"command":@((uintptr_t)encoder->command_buffer), @"prefix_encoder":@((uintptr_t)encoder->obj),
+        @"scope_host_ns":@(ggml_metal_q_attribution_now()),
+        @"node":@(node->name), @"op":@(ggml_op_name(node->op)),
+        @"weight":bitnet_q_probe_tensor(node->src[0],weight), @"input":bitnet_q_probe_tensor(node->src[1],input),
+        @"output":bitnet_q_probe_tensor(node,output), @"mode":@(bitnet_q_probe_mode),
+        @"planned_pipeline":@(ggml_metal_pipeline_name(pipeline)), @"planned_native_PSO":@((uintptr_t)pipeline.pipeline->obj),
+        @"planned_pipeline_wrapper":@((uintptr_t)pipeline.pipeline), @"planned_args_hex":bitnet_q_probe_hex(args,args_size),
+        @"planned_args_bytes":@(args_size), @"pipeline_nr0":@(pipeline.nr0), @"pipeline_nr1":@(pipeline.nr1), @"pipeline_nsg":@(pipeline.nsg),
+        @"pipeline_execution_width":@(pipeline.pipeline->obj.threadExecutionWidth), @"pipeline_max_threads":@(pipeline.pipeline->obj.maxTotalThreadsPerThreadgroup),
+        @"planned_buffers":@{@"1":bitnet_q_probe_buffer(weight), @"2":bitnet_q_probe_buffer(input),
+            @"3":bitnet_q_probe_buffer(output), @"4":bitnet_q_probe_buffer(output), @"5":bitnet_q_probe_buffer(input)},
+        @"planned_grid":@[@(grid_x),@(grid_y),@(grid_z)], @"planned_threads":@[@(threads_x),@(threads_y),@1],
+        @"planned_smem":@(smem), @"actual_buffers":[NSMutableDictionary dictionary], @"scope_dispatches":@0,
+        @"sample_start_index":@(2*index), @"sample_end_index":@(2*index+1),
+        @"encoder_scope_ended":@NO, @"tuple_verified":@NO, @"consumed_graph_nodes_required":@1
+    } mutableCopy];
+    [bitnet_q_probe_records addObject:record]; [record release];
+    pthread_mutex_unlock(&bitnet_q_command_lock);
+
+    // Explicit dependencies also cover untracked buffers. The sampled range includes the wait.
+    [encoder->obj updateFence:fence]; [encoder->obj endEncoding]; [encoder->obj release];
+    MTLComputePassDescriptor * descriptor=[MTLComputePassDescriptor computePassDescriptor];
+    descriptor.dispatchType=encoder->concurrent?MTLDispatchTypeConcurrent:MTLDispatchTypeSerial;
+    descriptor.sampleBufferAttachments[0].sampleBuffer=bitnet_q_probe_samples;
+    descriptor.sampleBufferAttachments[0].startOfEncoderSampleIndex=2*index;
+    descriptor.sampleBufferAttachments[0].endOfEncoderSampleIndex=2*index+1;
+    encoder->obj=[encoder->command_buffer computeCommandEncoderWithDescriptor:descriptor];
+    if (!encoder->obj) { GGML_ABORT("Qcur0 probe encoder creation failed"); }
+    [encoder->obj retain]; [encoder->obj waitForFence:fence];
+    encoder->q_probe_record=record; encoder->q_probe_fence=fence; encoder->q_probe_active=true;
+    record[@"selected_encoder"]=@((uintptr_t)encoder->obj);
+    return true;
+}
