 static bool ggml_metal_bitnet_numerics_active() {
     const char * directory=std::getenv("GGML_METAL_BITNET_FFN_NUMERICS_DIR");
     const char * route=std::getenv("GGML_METAL_BITNET_FFN_NUMERICS_ROUTE");
